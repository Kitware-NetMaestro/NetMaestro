{
  "$schema": "https://biomejs.dev/schemas/2.4.14/schema.json",
  "extends": ["@resonant/biome-config"],
  "files": {
    "includes": [
      "**",
      // Biome doesn't support Django HTML
      "!**/*.html",
      // Managed by upstream Resonant
      "!./vscode/*"
    ]
  },
  // Dependencies are resolved via cdn/esm imports and importmapping, not npm packages
  // Remove if build/bundling is implemented
  "linter": {
    "rules": {
      "correctness": {
        "noUndeclaredDependencies": "info"
      }
    }
  }
}
