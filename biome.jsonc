{
  "$schema": "https://biomejs.dev/schemas/2.4.10/schema.json",
  "extends": ["@resonant/biome-config"],
  "files": {
    "includes": [
      "**",
      // Biome doesn't support Django HTML
      "!**/*.html",
      // Managed by upstream Resonant
      "!./vscode/*"
    ]
  },
  "javascript": {
    "globals": ["_", "Alpine", "Plotly"]
  }
}
